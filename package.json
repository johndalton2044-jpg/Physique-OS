{
  "name": "physique-os",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first, single-file adaptive body-composition operating system.",
  "type": "module",
  "scripts": {
    "food": "node --max-old-space-size=3072 scripts/food-build.mjs --foundation raw/FoodData_Central_foundation_food_json_2026-04-30.json --branded-zip ../FoodData_Central_branded_food_json_2026-04-30.zip --out dist/data/food",
    "build": "node build.mjs",
    "test": "node tests/run.mjs",
    "engine": "node tests/engine-check.mjs",
    "package": "npm run check && tar -czf physique-os-dist.tar.gz -C dist .",
    "serve": "node scripts/serve.mjs",
    "fndds": "node scripts/fndds-build.mjs --in ./fndds-csv --out dist/data/food/fndds",
    "dsld": "node scripts/dsld-build.mjs --in ./dsld-export --out dist/data/supplements",
    "reference": "node scripts/reference-build.mjs --out dist/data/reference",
    "verify": "node scripts/verify-dist.mjs --dist ./dist",
    "check": "npm run build && npm run engine && npm run test && npm run adversarial && npm run audit && npm run conformance && npm run governance && npm run shipped && npm run browser && npm run visual && npm run persistence && npm run spine && npm run parity && npm run adapt && npm run integration && npm run intelligence && npm run external && npm run perf && npm run yields:gate && npm run cloud:e2e && npm run baseline && npm run verify",
    "perf": "node tests/perf.mjs --years=1,5",
    "perf:full": "node tests/perf.mjs --years=1,5,10",
    "adversarial": "node tests/adversarial.mjs",
    "check:full": "npm run check && npm run perf:full",
    "server": "node server/server.mjs --port 8787 --data ./server-data",
    "cloud:e2e": "node tests/cloud-e2e.mjs",
    "yields": "node scripts/ah102-extract.mjs",
    "yields:geometry": "node scripts/ah102-geometry.mjs",
    "audit": "node tests/audit.mjs",
    "yields:gate": "node scripts/yields-gate.mjs --check",
    "conformance": "node tests/conformance.mjs",
    "browser": "node tests/browser.mjs",
    "baseline": "node scripts/baseline.mjs",
    "shipped": "node tests/shipped.mjs",
    "governance": "node tests/governance.mjs",
    "visual": "node tests/visual.mjs",
    "visual:update": "node tests/visual.mjs --update",
    "release": "node tests/release.mjs",
    "persistence": "node tests/persistence.mjs && node tests/persistence.mjs --delayed && node tests/persistence.mjs --delayed --throttle=6",
    "spine": "node tests/spine.mjs",
    "parity": "node tests/parity.mjs",
    "adapt": "node tests/adapt.mjs",
    "integration": "node tests/integration.mjs",
    "intelligence": "node tests/intelligence.mjs",
    "external": "node tests/external.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
