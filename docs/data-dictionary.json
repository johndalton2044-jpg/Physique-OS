  },
  {
   "id": "rate_band",
   "cls": "POLICY",
   "output": "the lb/week range this system elects to work within for the current weight zone",
   "uncertainty": "a policy range, not an estimate",
   "inputs": [
    "weight|current weight",
    "record.phases|phase"
   ]
  },
  {
   "id": "recovery",
   "cls": "HEURISTIC",
   "output": "good / acceptable / strained / poor / unknown with the signals that drove it",
   "uncertainty": "ordinal level from the count and severity of signals",
   "inputs": [
    "sleep",
    "sleepq|sleep quality",
    "fatigue",
    "soreness",
    "stress"
   ]
  },
  {
   "id": "recovery_allocation",
   "cls": "HEURISTIC",
   "output": "weekly recovery budget and its split",
   "uncertainty": "relative units",
   "inputs": [
    "sleep",
    "steps",
    "cardio"
   ]
  },
  {
   "id": "response_matrix",
   "cls": "EMPIRICAL",
   "output": "effect per unit change, n, confidence and confounders per variable",
   "uncertainty": "effect per unit with n and confounder count",
   "inputs": [
    "record.experiments|completed experiments",
    "record.interventions|interventions",
    "weight_trend|weight trend before/after",
    "record.phases|phase",
    "rate_band|weight zone"
   ]
  },
  {
   "id": "strength_trend",
   "cls": "DERIVED",
   "output": "improving / stable / declining per exercise and overall",
   "uncertainty": "direction per lift; confidence from the number of tracked lifts",
   "inputs": [
    "record.sessions|sessions",
    "e1rm|e1RM per exercise"
   ]
  },
  {
   "id": "supplement_adherence",
   "cls": "DERIVED",
   "output": "taken vs due, per supplement",
   "uncertainty": "count",
   "inputs": [
    "supplement"
   ]
  },
  {
   "id": "supplement_efficacy",
   "cls": "EMPIRICAL",
   "output": "on-vs-off difference per supplement",
   "uncertainty": "standard error",
   "inputs": [
    "supplement"
   ]
  },
  {
   "id": "tdee_personal",
   "cls": "EMPIRICAL",
   "output": "estimated TDEE with interval, evidence count and calibration status",
   "uncertainty": "95% interval combining slope error, tissue-density spread and logging error",
   "inputs": [
    "calories",
    "weight_trend|weight trend",
    "adherence|logging coverage",
    "adherence"
   ]
  },
  {
   "id": "tdee_prior",
   "cls": "PRIOR",
   "output": "starting estimate with ± ~15% uncertainty; replaced as personal evidence accumulates",
   "uncertainty": "±15% band around the population equation",
   "inputs": [
    "profile.age|age",
    "profile.sex|sex",
    "profile.heightIn|height",
    "weight",
    "profile.activityBaseline|activity baseline"
   ]
  },
  {
   "id": "uncertainty_chain",
   "cls": "DERIVED",
   "output": "an energy-balance interval and the decision confidence ceiling it implies",
   "uncertainty": "the interval it produces is the uncertainty",
   "inputs": [
    "calories|intake coverage",
    "measurement_quality|measurement quality",
    "tdee_personal|TDEE interval",
    "weight_trend|trend interval"
   ]
  },
  {
   "id": "unified_optimiser",
   "cls": "PREDICTIVE",
   "output": "the Pareto set of changes across nutrition, activity, training, recovery and schedule, ranked by preference",
   "uncertainty": "combined standard deviation and robustness",
   "inputs": [
    "weight",
    "steps",
    "calories",
    "fatigue"
   ]
  },
  {
   "id": "water_noise",
   "cls": "HEURISTIC",
   "output": "low / medium / high",
   "uncertainty": "ordinal (low / medium / high) with the drivers listed",
   "inputs": [
    "water_noise|weight volatility",
    "context|context tags",
    "record.phases|phase age",
    "carbs|carbohydrate swings"
   ]
  },
  {
   "id": "weight_avg",
   "cls": "DERIVED",
   "output": "7- and 14-day mean of daily weight",
   "uncertainty": "none (a mean); its inputs carry the noise",
   "inputs": [
    "weight"
   ]
  },
  {
   "id": "weight_forecast",
   "cls": "PREDICTIVE",
   "output": "point and interval at 7/14/28 days; stamped to the ledger before outcomes",
   "uncertainty": "point plus interval from slope error and scale noise",
   "inputs": [
    "weight_avg|7-day average",
    "weight_trend|trend",
    "water_noise|residual noise"
   ]
  },
  {
   "id": "weight_trend",
   "cls": "DERIVED",
   "output": "slope in lb/week with residual noise and confidence",
   "uncertainty": "95% slope interval from the OLS standard error, plus residual noise",
   "inputs": [
    "weight"
   ]
  }
 ],
 "concepts": {
  "weight": {
   "unit": "lb (canonical)",
   "owner": "currentWeight",
   "meaning": "scale mass, as recorded",
   "notes": "stored canonically in pounds; display converts"
  },
  "calories": {
   "unit": "kcal/day",
   "owner": "food log",
   "meaning": "energy INTAKE as logged",
   "notes": "logged intake is not absorbed intake — see absorptionContext()"
  },
  "tdee": {
   "unit": "kcal/day",
   "owner": "tdeePersonal",
   "meaning": "maintenance energy, fitted from intake and weight change",
   "notes": "an estimate with an interval, never a measurement"
  },
  "e1rm": {
   "unit": "lb",
   "owner": "e1rmFrom",
   "meaning": "estimated one-rep maximum from a submaximal set",
   "notes": "Epley; degrades badly above about fifteen effective reps"
  },
  "rir": {
   "unit": "count",
   "owner": "effortOf",
   "meaning": "reps left in reserve at the end of a set",
   "notes": "subjective; reliability falls as the number rises"
  },
  "stimulus": {
   "unit": "index",
   "owner": "mechanicalDemand",
   "meaning": "weighted exposure, comparable within a programme",
   "notes": "not a physical quantity and not comparable between people"
  },
  "fatigue": {
   "unit": "index",
   "owner": "fatigueCompartments",
   "meaning": "accumulated exposure by compartment",
   "notes": "an accounting scheme, not a measurement of fatigue"
  },
  "kcalPerLb": {
   "unit": "kcal/lb",
   "owner": "tissueEnergyDensity",
   "meaning": "energy behind a pound of scale weight",
   "notes": "composition-dependent; 3500 is adipose tissue alone"
  },
  "readiness": {
   "unit": "z (own baseline)",
   "owner": "readinessState",
   "meaning": "today against your own middle per signal",
   "notes": "relative to the person, meaningless as an absolute"
  },
  "trainingLoad": {
   "unit": "ratio",
   "owner": "trainingLoad",
   "meaning": "acute against own chronic average",
   "notes": "descriptive; its predictive value for injury is contested"
  }
 },
