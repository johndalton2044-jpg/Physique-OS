{
  "rewrites": [
    {
      "source": "/api/sync/:path*",
      "destination": "https://REPLACE-WITH-YOUR-SYNC-SERVER/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(index.html|sw.js|version.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(self), camera=(self)"
        }
      ]
    }
  ]
}
